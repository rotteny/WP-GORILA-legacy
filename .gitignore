# Laradock — clonado pelo setup.sh, não versionar
/laradock/

# Sessões Baileys (multi-sessão): cada projeto = subpasta auth_info/{slug}/
# NUNCA comitar — contém credenciais sensíveis
/whatsapp-service/auth_info/*
!/whatsapp-service/auth_info/.gitkeep

# Node
**/node_modules/
**/npm-debug.log*
**/yarn-error.log

# PHP / Laravel
/laravel/vendor/
/laravel/storage/logs/*
!/laravel/storage/logs/.gitkeep
/laravel/storage/framework/cache/*
!/laravel/storage/framework/cache/.gitkeep
/laravel/storage/framework/sessions/*
!/laravel/storage/framework/sessions/.gitkeep
/laravel/storage/framework/views/*
!/laravel/storage/framework/views/.gitkeep
/laravel/bootstrap/cache/*
!/laravel/bootstrap/cache/.gitkeep

# Vite build output (regerado por npm run build)
/laravel/public/build/
/laravel/public/hot

# Scribe: artefatos gerados (php artisan scribe:generate regenera)
/laravel/.scribe/
/laravel/public/docs/

# Arquivos de ambiente
.env
.env.local
.env.*.local
!.env.example

# Editor / OS / IA helpers
.DS_Store
.idea/
.vscode/
.claude/
*.swp
*.log
