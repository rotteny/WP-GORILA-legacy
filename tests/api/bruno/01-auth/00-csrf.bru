meta {
  name: 00 - GET CSRF token
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/login
  body: none
  auth: none
}

script:post-response {
  // Extrai o _token do HTML e guarda como variável de runtime
  const html = res.getBody();
  const match = html && html.match(/name="_token"\s+value="([^"]+)"/);
  if (match) {
    bru.setVar("csrfToken", match[1]);
  } else {
    console.warn("Não consegui extrair CSRF token");
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("csrfToken foi capturado", function () {
    expect(bru.getVar("csrfToken")).to.be.a("string");
  });
}
