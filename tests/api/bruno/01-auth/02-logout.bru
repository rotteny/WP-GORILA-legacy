post {
  url: {{baseUrl}}/logout
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  _token: {{csrfToken}}
}

tests {
  test("redireciona após logout", function () {
    expect([200, 302, 303]).to.include(res.getStatus());
  });
}
