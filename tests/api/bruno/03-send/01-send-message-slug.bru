meta {
  name: 01 - POST /instances/{slug}/send-message
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/whatsapp/instances/{{slug}}/send-message
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "number": "{{destNumber}}",
    "message": "{{testTag}} send-message com slug"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("ok=true", function () {
    expect(res.getBody().ok).to.equal(true);
  });
  test("id retornado pelo Baileys", function () {
    expect(res.getBody().id).to.be.a("string");
  });
}
